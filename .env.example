# ─── Database ───────────────────────────────────────────────
# MongoDB Atlas connection string
MONGODB_URI="mongodb://127.0.0.1:27017/leadforge"

# ─── Auth ───────────────────────────────────────────────────
# Long random string used to sign JWTs
JWT_SECRET="change-me-to-a-long-random-secret"

# ─── AI (optional — app runs with template fallback if empty) ─
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""

# ─── Lead Finder (optional) ─────────────────────────────────
# Google Places API key for compliant business discovery
GOOGLE_PLACES_API_KEY=""

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="LeadForge AI"
